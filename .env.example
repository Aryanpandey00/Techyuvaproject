# ==============================================================================
# AI Memory Compression System - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend Configuration
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000/api/v1

# Vector & Metadata Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=llm_conversational_memories
SQLITE_DB_PATH=./data/memory_metadata.db

# Embedding Model Configuration
# Options: all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5, mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LLM Provider Configuration
# Options: mock, openai, local
LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LOCAL_MODEL_NAME=meta-llama/Llama-3-8B-Instruct

# Memory Lifecycle & Compression Thresholds
MEMORY_SIMILARITY_THRESHOLD=0.78
COMPRESSION_CLUSTER_MIN_SIZE=2
MAX_RETRIEVED_MEMORIES=5
IMPORTANCE_DECAY_RATE=0.05
FORGETTING_THRESHOLD=0.20
